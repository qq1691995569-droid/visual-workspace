# Local server-only configuration. Never prefix these with VITE_.
# DREO origin/token are read from ~/.dreo-visual-lab/credentials.json.
# Optional vision provider with an OpenAI-compatible chat/completions JSON API:
CANVAS_VISION_ENDPOINT=
CANVAS_VISION_TOKEN=
CANVAS_VISION_MODEL=
# Or reuse an existing local workflow .env file (server reads only analysis settings):
CANVAS_VISION_CONFIG_PATH=
# Optional Python override (Pillow and numpy required):
CANVAS_PYTHON=

# Optional absolute path to DREO credentials.json (origin + token):
CANVAS_DREO_CONFIG=
